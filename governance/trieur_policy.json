{
  "version": 4,
  "allowed_statuses": [
    "canonical",
    "active",
    "superseded",
    "archived"
  ],
  "runtime_forbidden_statuses": [
    "superseded",
    "archived"
  ],
  "managed_roots": [
    "data",
    "scenes",
    "scripts",
    "docs"
  ],
  "archive_root": "archive",
  "rules": {
    "superseded_requires_replacement": true,
    "replacement_must_exist": true,
    "replacement_cycles_forbidden": true,
    "archived_must_live_under_archive_root_when_moved": true,
    "duplicate_canonical_keys_forbidden": true,
    "runtime_must_not_reference_inactive_entries": true,
    "managed_paths_must_stay_in_managed_roots": true,
    "archive_requires_explicit_opt_in": true,
    "archive_requires_target": true,
    "archive_target_must_be_under_archive_root": true,
    "archive_apply_forbidden_on_main": true,
    "archive_destination_collision_forbidden": true,
    "archive_integrity_verification_required": true,
    "archive_registry_update_required": true,
    "automatic_delete_forbidden": true
  },
  "entries": [
    {
      "id": "litd-starting-quartet",
      "path": "data/heroes.json",
      "status": "canonical",
      "canonical_key": "litd.starting_quartet",
      "canon_version": 1,
      "description": "Canonical runtime source for the validated starting quartet: Mathilde, Marec, Anouk and Aurélien."
    },
    {
      "id": "litd-file-sorter-manifest",
      "path": "data/maintenance/canonical_files.json",
      "status": "canonical",
      "canonical_key": "litd.governance.file_sorter_manifest",
      "canon_version": 1,
      "description": "Canonical manifest for physical file classification, protected paths and evidence-backed obsolescence."
    },
    {
      "id": "litd-ux-ui-bible",
      "path": "docs/BIBLE_UX_UI_LITD.md",
      "status": "canonical",
      "canonical_key": "litd.design.ux_ui_bible",
      "canon_version": 1,
      "description": "Canonical UX/UI reference for LITD."
    },
    {
      "id": "litd-trieur-governance-doc",
      "path": "docs/governance/TRIEUR_V2.md",
      "status": "canonical",
      "canonical_key": "litd.governance.trieur_documentation",
      "canon_version": 1,
      "description": "Canonical documentation for Trieur governance and lifecycle rules."
    },
    {
      "id": "litd-knowledge-readme",
      "path": "docs/knowledge/README.md",
      "status": "canonical",
      "canonical_key": "litd.knowledge.overview",
      "canon_version": 1,
      "description": "Canonical overview of the LITD knowledge system."
    },
    {
      "id": "litd-knowledge-guardian-rules",
      "path": "docs/knowledge/guardian-rules.yml",
      "status": "canonical",
      "canonical_key": "litd.knowledge.guardian_rules",
      "canon_version": 1,
      "description": "Canonical Guardian rules for the LITD knowledge governance layer."
    },
    {
      "id": "litd-knowledge-dependencies",
      "path": "docs/knowledge/dependencies.yml",
      "status": "canonical",
      "canonical_key": "litd.knowledge.dependencies",
      "canon_version": 1,
      "description": "Canonical dependency map for LITD knowledge governance."
    },
    {
      "id": "litd-knowledge-adr-0001",
      "path": "docs/knowledge/decisions/ADR-0001-guardian-progressif.md",
      "status": "canonical",
      "canonical_key": "litd.knowledge.adr.0001",
      "canon_version": 1,
      "description": "Canonical ADR defining the progressive Guardian governance decision."
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "litd://governance/specialized-learning/benchmark-record/v1",
  "title": "Specialized Learning Coding Benchmark Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "domain", "repository_revision", "acceptance_criteria", "baseline", "result", "regressions", "lesson_candidates"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "domain": {"enum": ["litd_game_engineering", "henolos_software_engineering"]},
    "repository_revision": {"type": "string", "minLength": 7},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "baseline": {
      "type": "object",
      "required": ["checks", "observations"],
      "properties": {
        "checks": {"type": "array", "items": {"type": "string"}},
        "observations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "attempts": {"type": "array", "items": {"type": "string"}, "default": []},
    "result": {
      "type": "object",
      "required": ["checks", "observations"],
      "properties": {
        "checks": {"type": "array", "items": {"type": "string"}},
        "observations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "regressions": {"type": "array", "items": {"type": "string"}},
    "simplicity_notes": {"type": "array", "items": {"type": "string"}, "default": []},
    "security_privacy_checks": {"type": "array", "items": {"type": "string"}, "default": []},
    "lesson_candidates": {"type": "array", "items": {"type": "string"}}
  }
}

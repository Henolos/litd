[application]
config/name="Light in the Dark"
config/features=PackedStringArray("4.7")

[autoload]
GameSettings="*res://scripts/core/game_settings.gd"
SaveManager="*res://scripts/core/save_manager.gd"
MusicLibrary="*res://scripts/core/music_library.gd"
SfxLibrary="*res://scripts/core/sfx_library.gd"
PrototypeAudioBank="*res://scripts/core/prototype_audio_bank.gd"
SfxRuntime="*res://scripts/core/sfx_runtime.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=0

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true

[input]
confirm={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":4194309),Object(InputEventKey,"physical_keycode":32)]}
back={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":4194305)]}
context_menu={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":4194308),Object(InputEventKey,"physical_keycode":77)]}
ash_guidance={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":71)]}
status_hud={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":72),Object(InputEventJoypadButton,"button_index":3)]}
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65),Object(InputEventKey,"physical_keycode":81),Object(InputEventKey,"physical_keycode":4194311)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68),Object(InputEventKey,"physical_keycode":4194313)]}
move_up={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87),Object(InputEventKey,"physical_keycode":90),Object(InputEventKey,"physical_keycode":4194320)]}
move_down={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83),Object(InputEventKey,"physical_keycode":4194322)]}
sprint={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194325)]}
interact={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":69),Object(InputEventKey,"physical_keycode":32)]}
camera_zoom_in={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":61)]}
camera_zoom_out={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":45)]}

game_menu={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":73)]}
